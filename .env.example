# Solana Configuration
SOLANA_NETWORK=devnet
RPC_ENDPOINT=https://api.devnet.solana.com

# Deployer wallet (array of numbers from keypair)
# Generate with: solana-keygen new
# Get array with: cat ~/.config/solana/id.json
DEPLOYER_PRIVATE_KEY=[]

# Program IDs (will be generated during deployment)
TOKEN_MINT=
TREASURY_WALLET=
GAME_PROGRAM_ID=

# Game Configuration
ENTRY_FEE_SOL=0.01
MAX_TOKENS_PER_GAME=1000
MAX_SUPPLY=10000000
