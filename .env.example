# Kalshi Bitcoin Prediction Bot - Environment Configuration

# ===========================================
# KALSHI API CREDENTIALS (Required for trading)
# ===========================================
# Sign up at https://kalshi.com
# Leave empty to run in analysis-only mode
KALSHI_EMAIL=
KALSHI_PASSWORD=

# Use Kalshi demo API for testing (true/false)
# Demo API: https://demo-api.kalshi.co
KALSHI_USE_DEMO=false

# ===========================================
# BOT CONFIGURATION
# ===========================================

# How often to scan markets and run analysis (milliseconds)
# Default: 60000 (1 minute)
SCAN_INTERVAL=60000

# Minimum confidence level to show trade recommendations (0-100)
# Default: 40
MIN_CONFIDENCE=40

# Primary timeframe for analysis (1m, 5m, 15m, 1h, 4h, 1d)
# Default: 1h
PRIMARY_TIMEFRAME=1h

# ===========================================
# AUTO-TRADING (USE WITH CAUTION)
# ===========================================

# Enable automatic order placement (true/false)
# Default: false - ONLY enable if you understand the risks
AUTO_TRADE=false

# Maximum contracts per trade
# Default: 10
MAX_POSITION_SIZE=10

# Maximum daily loss before stopping (in dollars)
# Default: 100
MAX_DAILY_LOSS=100
